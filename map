    │   │   ├── rows.js         ← بناء صفوف الجداول والأزرار
    │   │   ├── add-box.js      ← صندوق "إضافة جديد" داخل القوائم
    │   │   └── lists.js        ← تحميل القوائم المنسدلة (جهات، منفقون، مصادر)
    │   │
    │   ├── pages/              ← منطق كل صفحة
    │   │   ├── expenses.js         ← صفحة المصروفات
    │   │   ├── loans.js            ← صفحة القبوضات
    │   │   ├── debts.js            ← صفحة الديون
    │   │   ├── cash.js             ← صفحة الصندوق (الرصيد حسب السنة والشهر)
    │   │   ├── destinations.js     ← إدارة الجهات المستفيدة
    │   │   ├── spenders.js         ← إدارة المنفقين
    │   │   ├── summary.js          ← الملخص الشهري والتصدير
    │   │   ├── expenses-report.js  ← تقرير المصروفات
    │   │   ├── loans-report.js     ← تقرير القبوضات
    │   │   ├── settings.js         ← الإعدادات وتغيير كلمة السر
    │   │   ├── admin.js            ← إدارة المحاسبين (للأدمن فقط)
    │   │   └── backup.js           ← واجهة النسخ الاحتياطي والاستيراد
    │   │
    │   └── app/                ← تشغيل البرنامج وربط الأجزاء
    │       ├── nav.js              ← التنقل بين الصفحات
    │       ├── auth.js             ← الدخول والخروج وإظهار كلمة السر (ويستدعي شاشة البداية)
    │       ├── network.js 🆕       ← عرض شاشة انقطاع الإنترنت وزر الخروج
    │       ├── splash.js 🆕        ← تشغيل شاشة البداية حتى الضغط على صفحة
    │       └── main.js             ← نقطة بدء الواجهة بعد التحميل
    │
    └── lib/
        └── flatpickr.*         ← مكتبة اختيار التاريخ (ملفات js وcss وlocale)