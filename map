    │   ├── print.css           ← تنسيق الطباعة
    │   ├── network.css 🆕      ← شاشة "لا يوجد اتصال بالإنترنت"
    │   └── splash.css 🆕       ← شاشة البداية والحركة
    │
    ├── js/
    │   ├── core/               ← أدوات أساسية مشتركة
    │   │   ├── app.js          ← الكائن العام App وحالة البرنامج
    │   │   ├── utils.js        ← دوال عامة (تنسيق أرقام، رسائل خطأ، تنبيهات)
